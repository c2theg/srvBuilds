##############################################################################################
#   Gitea — __GITEA_DOMAIN__
#
#   Generated by install-gitea.sh from nginx_gitea.conf.template. Edit the template, not this file.
#
#   Request path:
#     browser / git client ──HTTPS──▶ Cloudflare (orange cloud) ──HTTPS──▶ this nginx
#       ──HTTP──▶ Gitea container (127.0.0.1:__GITEA_HTTP_PORT__)
#
#   git over SSH does NOT pass through here or through Cloudflare. It goes straight to the
#   server on port __GITEA_SSH_PORT__ via the DNS-only record __GITEA_SSH_DOMAIN__.
#
#   On a standby server Gitea isn't running, so this site returns 502 there. That's expected;
#   Cloudflare DNS only points at the primary.
#
#   Omitted on purpose: nginx_global_security.conf (its Content-Security-Policy only allows your
#   company domains and would break Gitea's pages) and nginx_global_filetypes.conf (its
#   location blocks would grab Gitea's /assets/*.js and *.css requests).
##############################################################################################

# Behind Cloudflare, $remote_addr is a Cloudflare server. CF-Connecting-IP holds the real
# visitor. Falls back to $remote_addr for direct LAN/VPN access.
map $http_cf_connecting_ip $gitea_client_ip {
    ""      $remote_addr;
    default $http_cf_connecting_ip;
}

# ── HTTP → HTTPS redirect ──────────────────────────────────────────────────────
server {
    listen      80;
    server_name __GITEA_DOMAIN__;
    return      301 https://__GITEA_DOMAIN__$request_uri;
}

# ── Main HTTPS server ──────────────────────────────────────────────────────────
server {
    listen      443 ssl;
    http2       on;
    server_name __GITEA_DOMAIN__;

    ssl_certificate      __TLS_CERT__;
    ssl_certificate_key  __TLS_KEY__;

    include __NGINX_SNIPPETS_DIR__/nginx_global_tls.conf;
    include __NGINX_SNIPPETS_DIR__/logging_remote.conf;

    add_header Strict-Transport-Security "max-age=63072000" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header X-Frame-Options           "SAMEORIGIN" always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
    add_header X-Robots-Tag              "noindex, nofollow" always;

    # Cloudflare Free/Pro rejects request bodies over 100 MB anyway. Pushes bigger than that
    # over HTTPS fail at Cloudflare. Use SSH for big pushes.
    client_max_body_size 100m;

    # Stream git traffic instead of buffering whole pushes/clones to disk.
    proxy_request_buffering off;
    proxy_buffering         off;
    proxy_read_timeout      600s;
    proxy_send_timeout      600s;
    proxy_connect_timeout   10s;

    location / {
        proxy_pass         http://127.0.0.1:__GITEA_HTTP_PORT__;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $gitea_client_ip;
        proxy_set_header   X-Forwarded-For   $gitea_client_ip;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";
    }
}
