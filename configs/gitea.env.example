##############################################################################################
#   Gitea settings — THE ONE FILE YOU EDIT
#
#   How to use:
#     1. cp gitea.env.example gitea.env
#     2. Change every value marked  <-- CHANGE ME
#     3. sudo ./install-gitea.sh            (on the primary server)
#        sudo ./install-gitea.sh --standby  (on every backup server)
#
#   Use the SAME gitea.env on every server. Values are plain KEY=value (no quotes, no spaces).
#
#   Passwords and secret keys do NOT go here. The installer generates them once and saves them
#   in  $GIT_SYNC_BASE/instance/secrets.env  so every server shares the same secrets (needed
#   for failover: login sessions, 2FA, and tokens are encrypted with those keys).
##############################################################################################


# ── Names / URLs ────────────────────────────────────────────────────────────────────────────

# Web address for Gitea. In Cloudflare this record should be PROXIED (orange cloud).
GITEA_DOMAIN=git.example.com                              # <-- CHANGE ME

# Hostname used for "git clone ssh://..." URLs. Cloudflare can NOT proxy SSH on normal plans,
# so this must be a DNS-ONLY (grey cloud) record pointing straight at the primary server's IP.
# It could also be a Nebula VPN IP or hostname if you only use SSH over the VPN.
GITEA_SSH_DOMAIN=git-ssh.example.com                      # <-- CHANGE ME

# First admin account (created on the first install of the primary only).
GITEA_ADMIN_USER=gitadmin                                 # <-- CHANGE ME (not "admin"; Gitea reserves it)
GITEA_ADMIN_EMAIL=admin@example.com                       # <-- CHANGE ME

# Organizations to create, space separated. An organization is a folder for related projects,
# e.g. repos end up at  <org>/<project>  like  magnetoai/website  or  galviron/gps-platform.
# Leave empty to create none. Use lowercase, digits, - and _ only.
GITEA_ORGS=                                               # <-- e.g. magnetoai galviron tag-insights personal


# ── Storage ─────────────────────────────────────────────────────────────────────────────────

# A folder INSIDE an existing Resilio Sync share. Must be the SAME path on every server.
# Everything under here is copied to your other servers by Resilio:
#   repositories/   the actual git repositories  (<org>/<project>.git)
#   backups/        nightly .tar.gz backups (newest 5 kept)
#   instance/       shared secrets, TLS certs, and the "who is primary" marker
# Your existing sites keep synced files under /media/data/sync/..., so something like
#   /media/data/sync/git-projects  would match your current layout.
GIT_SYNC_BASE=/srv/resilio-sync/git-projects              # <-- CHANGE ME

# LOCAL-ONLY folder (NOT synced). Holds the running database and Gitea's working data.
# A live database must never be file-synced: a copy taken mid-write is corrupt.
# The database reaches other servers through the nightly backups instead.
GITEA_LOCAL_BASE=/opt/gitea


# ── Ports ───────────────────────────────────────────────────────────────────────────────────

# Web UI port, bound to 127.0.0.1 only (nginx forwards to it). 3000 is already used by gps.
GITEA_HTTP_PORT=3300

# Public SSH port for git push/pull. Port 22 stays with the server's normal SSH login.
GITEA_SSH_PORT=2222


# ── TLS (HTTPS) ─────────────────────────────────────────────────────────────────────────────
#   Cloudflare → your nginx uses these files. Recommended: Cloudflare Origin Certificate
#   (Cloudflare dashboard → SSL/TLS → Origin Server → Create Certificate), same as gps.
#   Set Cloudflare SSL/TLS mode to "Full (strict)".
#   If the files don't exist, the installer creates a temporary self-signed cert at these
#   paths (works with Cloudflare "Full" mode, NOT "Full (strict)") so nginx can start.
#   Must be a path that exists on EVERY server, because your nginx sites-enabled is synced.
#   Leave blank to use  $GIT_SYNC_BASE/instance/tls/gitea_origin.pem  and  ..._key.pem
#   Or point at an existing wildcard cert, e.g.
#     TLS_CERT=/media/data/sync/sync_data_group_website/tls/yourdomain_cloudflare.pem
TLS_CERT=
TLS_KEY=


# ── nginx ───────────────────────────────────────────────────────────────────────────────────
NGINX_SITES_DIR=/etc/nginx/sites-enabled
NGINX_SNIPPETS_DIR=/etc/nginx/snippets


# ── Backups ─────────────────────────────────────────────────────────────────────────────────
BACKUP_KEEP=5
# Cron schedule (minute hour day month weekday). Default: every night at 02:30 server time.
BACKUP_CRON=30 2 * * *


# ── Versions ────────────────────────────────────────────────────────────────────────────────
# Pin versions so every server runs the same thing. Check for newer:
#   https://hub.docker.com/r/gitea/gitea/tags
# Upgrade = change tag, then: cd /opt/gitea && docker compose pull && docker compose up -d
GITEA_IMAGE_TAG=1.25
POSTGRES_IMAGE_TAG=17-alpine
